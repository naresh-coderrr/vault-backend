{
  "name": "vault-backend",
  "version": "1.0.0",
  "description": "Vault Distributed Object Storage - Gateway API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "node1": "node storage-node.js --port=9001 --dir=./node_data/node1 --name=Node-Alpha",
    "node2": "node storage-node.js --port=9002 --dir=./node_data/node2 --name=Node-Beta",
    "node3": "node storage-node.js --port=9003 --dir=./node_data/node3 --name=Node-Gamma",
    "init-db": "node db/init.js",
    "register-nodes": "node scripts/register-nodes.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "pg": "^8.23.0",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
